{
  "name": "Mir4-Local",
  "productName": "Mir4Local",
  "version": "1.1.0",
  "description": "Plain HTML/JS app packaged with Electron, auto-updating from GitHub Releases",
  "main": "main.js",
  "author": "fsocietyshinjuu",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "release": "electron-builder --publish always"
  },
  "build": {
    "appId": "com.fsocietyshinjuu.Mir4-Local",
    "files": ["main.js", "preload.js", "renderer/**/*"],
    "publish": [
  {
    "provider": "github",
    "owner": "fsocietyshinjuu",
    "repo": "Mir4-Local",
    "releaseType": "release"
  }
],
    "win": { "target": "nsis" },
    "mac": { "target": ["dmg", "zip"], "category": "public.app-category.productivity" },
    "linux": { "target": "AppImage", "category": "Utility" }
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
